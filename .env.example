# =========================================================
# CONFIGURACIÓN DE FIREBASE PARA NIGHTFLOW VIP CLUB
# =========================================================
# 1. Ve a https://console.firebase.google.com/
# 2. Crea un proyecto (o selecciona uno existente).
# 3. En la configuración del proyecto (ícono de engranaje ⚙️) -> "General":
#    Baja hasta "Tus apps", haz clic en el ícono Web </> y registra tu app.
# 4. Copia los valores del objeto `firebaseConfig` y pégalos aquí.
# 5. Guarda este archivo como `.env.local` en la raíz del proyecto.

VITE_FIREBASE_API_KEY=tu_api_key_aqui
VITE_FIREBASE_AUTH_DOMAIN=tu_proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu_proyecto_id
VITE_FIREBASE_STORAGE_BUCKET=tu_proyecto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=tu_sender_id
VITE_FIREBASE_APP_ID=tu_app_id

# Desarrollo con emuladores locales
# Firestore :8080 · Auth :9099 · Functions :5001
# VITE_USE_EMULATORS=1
# VITE_EMULATOR_HOST=127.0.0.1
# VITE_FUNCTIONS_EMULATOR_PORT=5001

# =========================================================
# FUNCTIONS / PAGOS / CLOUD TASKS (variables de entorno del backend)
# Colócalas en functions/.env o en la consola de Cloud Functions.
# =========================================================
# App Check (en emulador se desactiva solo con FUNCTIONS_EMULATOR=true)
# APP_CHECK_ENFORCED=true
# APP_CHECK_REQUIRED=true
# CAPTCHA_REQUIRED=false

# Holds y firmas
# HOLD_TOKEN_SECRET=cambiar_en_produccion
# APP_SECRET=cambiar_en_produccion
# OTP_HASH_SECRET=cambiar_en_produccion

# Webhook de pagos (HMAC del proveedor PSP)
# PAYMENT_WEBHOOK_SECRET=secret_del_proveedor
# PAYMENT_PROVIDER=mock
# PAYMENT_CHECKOUT_BASE_URL=https://checkout.tuproveedor.com/session

# Cloud Tasks (liberación de holds a los 12 min exactos)
# CLOUD_TASKS_QUEUE=nightflow-hold-release
# CLOUD_TASKS_LOCATION=us-central1
# CLOUD_TASKS_TARGET_URL=https://us-central1-TU_PROYECTO.cloudfunctions.net/releaseHoldTask
# CLOUD_TASKS_SERVICE_ACCOUNT_EMAIL=nightflow-tasks@TU_PROYECTO.iam.gserviceaccount.com

# OTP proveedores
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=

# =========================================================
# PUERTA (Cloud Run door-service) + NIGHTFLOW Edge (LAN)
# VITE_* se exponen al bundle del navegador: no pongas claves privadas.
# =========================================================
# URL base del microservicio de puerta (sin slash final)
# VITE_DOOR_SERVICE_URL=https://door-TU_PROYECTO.a.run.app

# Edge gateway en la red local del club (opcional, para coordinar puertas)
# El navegador NUNCA lleva claves HMAC: la PWA de puerta presenta un
# Firebase ID token de sesión; el Edge lo verifica con EDGE_FIREBASE_PROJECT_ID.
# VITE_EDGE_WS_URL=http://192.168.1.50:8787
# VITE_EDGE_BUSINESS_ID=club_tu_negocio
# VITE_EDGE_EVENT_ID=evt_sabado_vip

# Variables de servidor door-service / edge-gateway (NO VITE_*)
# DOOR_SIGNING_KEYS=
# DOOR_PRIVATE_KEY_BASE64=
# DOOR_ALLOWED_ORIGINS=
# ATTENDANCE_HMAC_SECRET=
# EDGE_HMAC_SECRET=
# EDGE_FIREBASE_PROJECT_ID=tu_proyecto_id
# BUSINESS_ID=
# EVENT_ID=
# GATEWAY_ID=
# EDGE_DATA_FILE=./data/events.jsonl
