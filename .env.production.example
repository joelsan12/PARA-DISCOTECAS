# =========================================================
# NIGHTFLOW VIP — Variables públicas para build de producción
# (solo claves VITE_* que el navegador puede ver)
# =========================================================
# Copia este archivo a `.env.production` y rellena los valores.
# Cargado por TODOS los builds (npm run build, build:client,
# build:admin) gracias a la fusión explícita en vite.config.ts.
# NUNCA pegues aquí: claves privadas, HMAC de servidor, tokens de
# PSP, credenciales de Twilio/Resend ni service accounts.

# Firebase Web App (consola → Configuración del proyecto → Tus apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (obligatorio fuera del emulador)
VITE_APPCHECK_SITE_KEY=
VITE_APPCHECK_PROVIDER=recaptcha_v3
# Solo descomenta en desarrollo local; nunca en producción:
# VITE_APPCHECK_DEBUG_TOKEN=

# Región de Cloud Functions
VITE_FUNCTIONS_REGION=us-central1

# Microservicio de puerta (Cloud Run)
# VITE_DOOR_SERVICE_URL=https://door-tu-proyecto.a.run.app

# Edge LAN (sin secretos en el bundle; la PWA presenta ID token de sesión)
# VITE_EDGE_WS_URL=http://192.168.1.50:8787
# VITE_EDGE_BUSINESS_ID=club_tu_negocio
# VITE_EDGE_EVENT_ID=evt_sabado_vip
