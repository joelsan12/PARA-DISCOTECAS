{
  "name": "edge-gateway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "npm run build && node --watch dist/index.js",
    "test": "npm run build && node --test dist/server.test.js dist/scenario.test.js dist/auth.test.js dist/persistence.test.js"
  },
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "jose": "^6.2.12",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/ws": "^8.5.14",
    "typescript": "^5.8.3"
  }
}
